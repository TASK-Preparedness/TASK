#!/bin/sh
# T.A.S.K. Mesh Operations launcher (design report §2.3).
# -I -S: ignore PYTHON* env vars, user site and /usr/local site-packages so pip-installed modules
# can never shadow Debian's; sys.path is then built explicitly. -B: never write bytecode at run
# time (it is compiled once by the package postinst and removed by prerm).
exec /usr/bin/python3 -I -S -B -c '
import sys
sys.path[:0] = ["/usr/lib/task-mesh", "/usr/lib/task-mesh/task_mesh/_vendor"]
sys.path.append("/usr/lib/python3/dist-packages")
from task_mesh.app import main
sys.exit(main(sys.argv[1:]))
' "$@"
